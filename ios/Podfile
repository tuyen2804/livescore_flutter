# Uncomment this line to define a global platform for your project
# platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ---- Mediation ----
  # Cùng 10 mạng với Android. Tên pod đã đối chiếu với CocoaPods trunk.
  # Nhớ: mỗi mạng còn phải bật trong AdMob Console mới có request thật, và
  # Info.plist cần bổ sung SKAdNetworkItems của từng mạng.
  pod 'GoogleMobileAdsMediationAppLovin'
  pod 'GoogleMobileAdsMediationIronSource'
  pod 'GoogleMobileAdsMediationVungle'
  pod 'GoogleMobileAdsMediationFacebook'
  pod 'GoogleMobileAdsMediationMintegral'
  pod 'GoogleMobileAdsMediationPangle'
  pod 'GoogleMobileAdsMediationUnity'
  pod 'GoogleMobileAdsMediationMoloco'
  pod 'GoogleMobileAdsMediationFyber'
  pod 'GoogleMobileAdsMediationBigo'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Podspec BigoADS còn sót các khoá EXCLUDED_ARCHS__…XCODE_1200… (workaround
    # Xcode 12 beta, không còn tác dụng) mang giá trị "arm64". Flutter dò regex
    # `EXCLUDED_ARCHS.*\barm64\b` nên tưởng Bigo không chạy được simulator arm64,
    # rồi loại arm64 khỏi cả app → Xcode build x86_64 và báo
    # "unsupported Swift architecture". Bigo có slice arm64 thật nên gỡ các khoá đó.
    next unless target.name.start_with?('BigoADS')
    target.build_configurations.each do |config|
      path = config.base_configuration_reference&.real_path
      next unless path && File.exist?(path)
      lines = File.readlines(path).reject { |line| line.start_with?('EXCLUDED_ARCHS') }
      File.write(path, lines.join)
    end
  end
end
